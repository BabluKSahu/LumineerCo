# AI Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id (numeric)
TELEGRAM_STORAGE_CHANNEL_ID=your_private_channel_id (numeric, e.g., -1001234567890)
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_token_here (optional, for webhook security)

# Hermes Webhook
HERMES_WEBHOOK_SECRET=your_hermes_webhook_secret_here (optional, for webhook security)

# Scheduler
SCHEDULER_WEBHOOK_SECRET=your_scheduler_webhook_secret_here (optional, for cron services)

# Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here

# Auth
ADMIN_PASSWORD=your_admin_password_here
JWT_SECRET=your_jwt_secret_here (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_here (generate with: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000

# Database (optional - for metadata only, main storage is Telegram)
DATABASE_URL=postgresql://user:pass@localhost:5432/lumineerco

# Deployment
VERCEL_URL=https://your-app.vercel.app